# Applies to every image built with the repository root as its context (all Dockerfiles in this
# repo are). Docker only reads .dockerignore from the context root, so this file must stay here.
**/.classpath
**/.dockerignore
**/.env
**/.git
**/.gitignore
**/.project
**/.settings
**/.toolstarget
**/.vs
**/.vscode
**/*.*proj.user
**/*.user
**/*.dbmdl
**/*.jfm
**/azds.yaml
**/bin
**/charts
**/docker-compose*
**/Dockerfile*
**/node_modules
**/npm-debug.log
**/obj
**/secrets.dev.yaml
**/values.dev.yaml
**/TestResults
LICENSE
README.md
CLAUDE.md
.github
.claude

# Local SQLite databases (e.g. the API's dev database)
**/*.db
**/*.db-shm
**/*.db-wal

# Needed by Visual Studio's container tooling
!**/.gitignore
!.git/HEAD
!.git/config
!.git/packed-refs
!.git/refs/heads/**
